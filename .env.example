NODE_ENV=development
PORT=3000
# Local HTTP is for UI development only. TikTok OAuth/App Review requires one public HTTPS origin.
PUBLIC_ORIGIN=http://localhost:3000
TIKTOK_CLIENT_KEY=replace_with_tiktok_client_key
TIKTOK_CLIENT_SECRET=replace_with_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback
# Keep 0 until TikTok has approved the Direct Post audit for this client.
TIKTOK_DIRECT_POST_AUDITED=0
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
# For production, omit this variable to use the default __Host-adh_session,
# or set it explicitly to that value. This development value supports local HTTP.
SESSION_COOKIE_NAME=adh_session
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
# Leave unset for local SQLite. Production requires the Neon URL with sslmode=require.
DATABASE_URL=
# Local development fallback only; ignored when DATABASE_URL is set.
DATABASE_PATH=./data/app.sqlite
# Render production uses /tmp/adh-uploads automatically.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=536870912
# Set to 1 behind the Render HTTPS proxy.
TRUST_PROXY=0
